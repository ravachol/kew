Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.mp3\shell\PlayWithKew]
@="Play with kew"
"Icon"="C:\\Program Files\\kew\\kew.exe"
"MultiSelectModel"="Player"

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.mp3\shell\PlayWithKew\command]
@="\"C:\\Program Files\\kew\\kew.exe\" play %1"

